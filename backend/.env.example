# ──────────────────────────────────────────────
# SQL Server connection — copy to .env and fill in
# ──────────────────────────────────────────────

# Your PC name or IP (e.g. DESKTOP-ABCXYZ or .\SQLEXPRESS or localhost)
DB_SERVER=localhost

# Leave blank for Windows Authentication, or set for SQL Login
DB_USER=
DB_PASSWORD=

# The database created by setup.sql
DB_DATABASE=FactoryLayoutDB

# Use Windows Auth (true) or SQL Login (false)
DB_WINDOWS_AUTH=true

# Backend port
PORT=4000

# Secret key used for signing JSON Web Tokens (JWT)
JWT_SECRET=super_secret_factory_layout_token_key_2026!
